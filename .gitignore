# --- Python (based on github/gitignore Python.gitignore) ---
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
wheels/
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/

# Unit test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# Type checkers / linters
.mypy_cache/
.ruff_cache/
.pyright/

# Jupyter
.ipynb_checkpoints/

# Environment / secrets
.env
.env.*
!.env.example

# --- IDE / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Project-specific ---
# Raw PDFs and the manifest ARE committed (CC licenses allow redistribution).
# Derived artifacts are regenerated by scripts and stay out of git.
data/cache/
data/interim/
runs/
*.log
